# Copy to .env.demo (git-ignored) and fill in. Used by compose.demo.yaml.
V2A_GPU_DEVICE=
V2A_DOCKER_UID=1000
V2A_DOCKER_GID=1000
V2A_INSPECT_UI_PORT=8501
V2A_INSPECT_UI_PASSWORD=

GEMINI_API_KEY=replace-me
ELEVENLABS_API_KEY=replace-me
# openssl rand -hex 24
AUDYSSEY_TOOL_TOKEN=

# LLM (fallback if unavailable: gemini-3.5-flash)
V2A_INSPECT_LLM_LARGE_MODEL=gemini-4-hydrogen
V2A_INSPECT_SELSYNC_SEED=42
V2A_INSPECT_TRACK_DESCRIPTION_DEFAULT=label

# Optional inference-server Bearer token (blank = no auth)
V2A_SERVER_API_TOKEN=
V2A_INSPECT_CLIENT_SERVER_TOKEN=

# Read-only weights cache (shared)
HF_CACHE=/home/common/huggingface
